    "「%@」沒有複製到文件旁邊的「%@」資料夾。請確認那個位置可以寫入。": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "new",
            "value": "「%1$@」沒有複製到文件旁邊的「%2$@」資料夾。請確認那個位置可以寫入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” could not be copied to the “%2$@” folder next to the document. Make sure that location is writable."
